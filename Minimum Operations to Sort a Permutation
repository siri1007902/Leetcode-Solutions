class Solution:
    def minOperations(self, nums: List[int]) -> int:
        n = len(nums)
        zero = nums.index(0)

        def is_increasing(step: int) -> bool:
            for i in range(1, n):
                prev = (zero + (i - 1) * step) % n
                curr = (zero + i * step) % n
                if nums[curr] != (nums[prev] + 1) % n:
                    return False
            return True

        ans = float('inf')
        if is_increasing(1):
            ans = min(ans, zero, n - zero + 2)
        if is_increasing(-1):
            ans = min(ans, zero + 2, n - zero)
        return ans if ans < float('inf') else -1


class Solution {
public:
    long long minOperations(vector<int>& nums, int x, int k) {
        int n = nums.size();

        vector<int> a = nums;
        sort(a.begin(), a.end());
        a.erase(unique(a.begin(), a.end()), a.end());

        int m = a.size();

        vector<long long> bitCount(m + 1, 0);
        vector<long long> bitSum(m + 1, 0);

        auto update = [&](vector<long long>& bit, int i, long long val) {
            for (; i <= m; i += i & -i)
                bit[i] += val;
        };

        auto query = [&](vector<long long>& bit, int i) {
            long long sum = 0;
            for (; i > 0; i -= i & -i)
                sum += bit[i];
            return sum;
        };

        auto kth = [&](int target) {
            int idx = 0;
            for (int step = 1 << 17; step > 0; step >>= 1) {
                int next = idx + step;
                if (next <= m && bitCount[next] < target) {
                    idx = next;
                    target -= bitCount[next];
                }
            }
            return idx + 1;
        };

        auto add = [&](int val, int delta) {
            int id = lower_bound(a.begin(), a.end(), val) - a.begin() + 1;
            update(bitCount, id, delta);
            update(bitSum, id, 1LL * val * delta);
        };

        auto getCost = [&]() -> long long {
            int mid = kth((x + 1) / 2);
            long long median = a[mid - 1];

            long long leftCount = query(bitCount, mid);
            long long leftSum = query(bitSum, mid);

            long long totalCount = x;
            long long totalSum = query(bitSum, m);

            long long rightCount = totalCount - leftCount;
            long long rightSum = totalSum - leftSum;

            return median * leftCount - leftSum
                 + rightSum - median * rightCount;
        };

        vector<long long> cost(n - x + 1);

        for (int i = 0; i < x; i++)
            add(nums[i], 1);

        cost[0] = getCost();

        for (int i = x; i < n; i++) {
            add(nums[i - x], -1);
            add(nums[i], 1);
            cost[i - x + 1] = getCost();
        }

        const long long INF = 1e18;

        vector<long long> prev(n + 1, 0);
        vector<long long> curr(n + 1, INF);

        for (int j = 1; j <= k; j++) {
            fill(curr.begin(), curr.end(), INF);

            for (int i = 1; i <= n; i++) {
                curr[i] = curr[i - 1];

                if (i >= x && prev[i - x] != INF) {
                    curr[i] = min(curr[i],
                                  prev[i - x] + cost[i - x]);
                }
            }

            prev.swap(curr);
        }

        return prev[n];
    }
};

class Solution {
public:
    int sumCounts(vector<int>& nums) {
        const long long MOD = 1000000007;
        int n = nums.size();

        vector<long long> sum(4 * n, 0);
        vector<long long> sq(4 * n, 0);
        vector<long long> lazy(4 * n, 0);

        auto update = [&](auto&& self, int node, int l, int r,
                          int ql, int qr) -> void {
            if (ql <= l && r <= qr) {
                long long len = r - l + 1;
                sq[node] = (sq[node] + 2 * lazy[node] * sum[node]
                            + len * lazy[node] % MOD * lazy[node]) % MOD;
                sum[node] = (sum[node] + len * lazy[node]) % MOD;
                lazy[node] = 0;
                sum[node] = (sum[node] + len) % MOD;
                sq[node] = (sq[node] + 2 * sum[node] - len) % MOD;
                return;
            }
        };

        auto apply = [&](int node, int l, int r, long long v) {
            long long len = r - l + 1;
            sq[node] = (sq[node] + 2 * v * sum[node] % MOD
                        + len * v % MOD * v) % MOD;
            sum[node] = (sum[node] + len * v) % MOD;
            lazy[node] = (lazy[node] + v) % MOD;
        };

        auto push = [&](int node, int l, int r) {
            if (lazy[node] == 0 || l == r) return;
            int mid = (l + r) / 2;
            apply(node * 2, l, mid, lazy[node]);
            apply(node * 2 + 1, mid + 1, r, lazy[node]);
            lazy[node] = 0;
        };

        auto upd = [&](auto&& self, int node, int l, int r,
                       int ql, int qr) -> void {
            if (ql > r || qr < l) return;
            if (ql <= l && r <= qr) {
                apply(node, l, r, 1);
                return;
            }
            push(node, l, r);
            int mid = (l + r) / 2;
            self(self, node * 2, l, mid, ql, qr);
            self(self, node * 2 + 1, mid + 1, r, ql, qr);
            sum[node] = (sum[node * 2] + sum[node * 2 + 1]) % MOD;
            sq[node] = (sq[node * 2] + sq[node * 2 + 1]) % MOD;
        };

        long long ans = 0;
        vector<int> last(100001, -1);

        for (int i = 0; i < n; i++) {
            int prev = last[nums[i]];
            upd(upd, 1, 0, n - 1, prev + 1, i);
            ans = (ans + sq[1]) % MOD;
            last[nums[i]] = i;
        }

        return ans;
    }
};


class Solution {
public:
    vector<int> maxDepthAfterSplit(string seq) {
        vector<int> ans;

        for (int i = 0; i < seq.size(); i++) {
            if (seq[i] == '(') {
                ans.push_back(i % 2);
            } else {
                ans.push_back(1 - (i % 2));
            }
        }

        return ans;
    }
};
